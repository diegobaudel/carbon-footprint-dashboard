+  font-family: var(--fuente-titulos);
+  font-size: 18px;
+  font-weight: 600;
+  color: #ffffff;
+}
+
+.fichaAyuda {
+  margin-top: 6px;
+  font-size: 11px;
+  line-height: 1.5;
+  color: #b6c0d0;
+}
+
+.fichaDatos {
+  margin: 0;
+  display: grid;
+  grid-template-columns: 1fr auto;
+  gap: 4px 10px;
+  font-size: 11px;
+}
+
+.fichaDatos dt {
+  color: #94a3b8;
+}
+
+.fichaDatos dd {
+  margin: 0;
+  text-align: right;
+  font-weight: 600;
+  color: #ffffff;
+}
+
+.fichaDatos .fichaBaja {
+  color: #2dd4bf;
+}
+
+.fichaDatos .fichaSube {
+  color: var(--escala-2);
+}
+
+/* Tooltip del globo (lo crea globe.gl fuera del módulo) */
+:global(.tooltip-globo) {
+  padding: 8px 10px;
+  border-radius: 8px;
+  background: rgba(8, 13, 26, 0.9);
+  border: 1px solid rgba(255, 255, 255, 0.15);
+  color: #e8edf5;
+  font-family: var(--fuente);
+  font-size: var(--texto-nota);
+  line-height: 1.5;
+}
+
+:global(.tooltip-globo strong) {
+  font-size: var(--texto-sec);
+}
+
+@media (max-width: 720px) {
+  /* En celular la ficha va abajo, compacta, para no tapar el globo */
+  .ficha {
+    top: auto;
+    left: 8px;
+    right: 8px;
+    bottom: 8px;
+    width: auto;
+    padding: 8px 10px;
+  }
+
+  .fichaAyuda {
+    display: none;
+  }
+
+  .fichaNombre {
+    margin: 2px 0 4px;
+    font-size: 15px;
+  }
+
+  .fichaDatos {
+    grid-template-columns: auto 1fr auto 1fr;
+    font-size: 10px;
+  }
+}
